      pre.textContent = '**' + (f.type.value || 'Bug report') + (f.project.value ? ' / ' + f.project.value : '') + '**\n' +
        (f.title.value ? 'Summary: ' + f.title.value + '\n' : '') +
        (f.details.value ? '\n' + f.details.value + '\n' : '') +
