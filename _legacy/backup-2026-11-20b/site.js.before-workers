    });
  }

  /* Hub bands follow the cursor */
  if (canHover && !calm) $$('[data-tilt]').forEach(function (b) {
    var img = $('.band__bg', b);
    pointerFrame(b, function (e) {
      var r = b.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
