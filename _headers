# Cache and security headers, Netlify format.
# https://docs.netlify.com/routing/headers/
#
# ⚠ INERT ON THE CURRENT DEPLOY. The site ships through GitHub Pages
# (.github/workflows/pages.yml), which serves no custom headers and ignores
# this file entirely — so none of the Cache-Control or security policies below
# are actually applied to visitors today.
#
# It is kept because it is correct and costs nothing: put a host that reads it
# in front (Netlify, Cloudflare Pages, a CDN) and everything here takes effect
# as written. In the meantime the one policy with a working HTML equivalent,
# the referrer policy, is set as a <meta> tag in _layouts/skyground_base.html.
# X-Content-Type-Options and X-Frame-Options have no <meta> equivalent by
# spec — there is no way to honour them from a static page on Pages.

# Static assets - cache for 1 year
/assets/Images/*
  Cache-Control: public, max-age=31536000, immutable
  
/assets/logos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/skyground/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/skyground/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML pages - cache for 5 minutes
/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts - cache for 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  
# Data files
/_data/*
  Cache-Control: no-cache, must-revalidate
