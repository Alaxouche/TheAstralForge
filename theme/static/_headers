# Cloudflare Pages response headers (copied to the root of _site by build.mjs).
# Patterns must not overlap: Cloudflare joins the values of every rule a URL matches.
# HTML keeps Cloudflare's default (always revalidated), so a deploy shows up at once.

/assets/site.css
  Cache-Control: public, max-age=31536000, immutable

/assets/site.js
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/Images/*
  Cache-Control: public, max-age=2592000

/assets/logos/*
  Cache-Control: public, max-age=2592000

/assets/forge/*
  Cache-Control: public, max-age=2592000

/assets/og/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
